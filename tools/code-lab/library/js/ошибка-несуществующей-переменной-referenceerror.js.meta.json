          "language": "js",
          "content": "const scope = { price: 100, quantity: 3 };\n\nfunction readVariable(name) {\n  if (!(name in scope)) {\n    throw new ReferenceError(`${name} не определена`);\n  }\n  return scope[name];\n}\n\nconsole.log(readVariable(\"price\"));\n\ntry {\n  readVariable(\"discount\");\n} catch (error) {\n  console.log(error.name, \"-\", error.message);\n}"
