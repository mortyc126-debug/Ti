        "title": "Применение",
        "code": {
          "language": "js",
          "content": "// w — веса бумаг [0.5, 0.5]; cov — матрица ковариаций N×N\nfunction дисперсияПортфеля(w, cov){\n  let сумма = 0;\n  for(let i = 0; i < w.length; i++){\n    for(let j = 0; j < w.length; j++){\n      сумма += w[i] * w[j] * cov[i][j]; // вклад пары (i,j)\n    }\n  }\n  return сумма;                        // дисперсия; корень = волатильность\n}"
        },
