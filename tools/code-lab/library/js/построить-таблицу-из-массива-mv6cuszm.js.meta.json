    "views": {
      "use": {
        "title": "Применение",
        "html": "<table id=\"colors\">\n  <thead><tr><th>Название</th><th>Код</th></tr></thead>\n  <tbody></tbody>\n</table>",
        "code": {
          "language": "javascript",
          "content": "function renderColors(colors) {\n  const tbody = document.querySelector('#colors tbody');\n  if (!tbody) throw new Error('Не найден #colors tbody');\n  tbody.replaceChildren();\n  colors.forEach(({ name, hex }) => {\n    const tr = document.createElement('tr');\n    const nameCell = document.createElement('td');\n    const hexCell = document.createElement('td');\n    nameCell.textContent = name;\n    hexCell.textContent = hex;\n    tr.append(nameCell, hexCell);\n    tbody.append(tr);\n  });\n}"
        },
        "steps": [
          "Добавь таблицу с id=colors и элементом <tbody>",
          "Вставь функцию renderColors в JavaScript",
          "Передай массив в renderColors(colors)"
        ],
        "example_input": [
          {
            "name": "Красный",
            "hex": "#ff0000"
          },
          {
            "name": "Синий",
            "hex": "#0000ff"
          }
        ],
        "demo": "renderColors(colors);"
      },
