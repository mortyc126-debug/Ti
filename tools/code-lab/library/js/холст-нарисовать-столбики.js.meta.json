          "language": "js",
          "content": "const ctx = document.querySelector(\"canvas\").getContext(\"2d\");\n\nconst значения = [40, 70, 30, 90];\nзначения.forEach((v, i) => {\n  ctx.fillStyle = \"#3DD9FF\";\n  ctx.fillRect(i * 30, 100 - v, 20, v); // x, y, ширина, высота\n});"
