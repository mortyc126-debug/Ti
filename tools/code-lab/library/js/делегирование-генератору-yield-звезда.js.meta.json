          "language": "js",
          "content": "function* evenNumbers(limit) {\n  for (let number = 0; number <= limit; number += 2) {\n    yield number;\n  }\n}\n\nfunction* sequence() {\n  yield \"старт\";\n  yield* evenNumbers(6);\n  yield* [\"a\", \"b\"];\n  yield \"финиш\";\n}\n\nconsole.log([...sequence()]);"
