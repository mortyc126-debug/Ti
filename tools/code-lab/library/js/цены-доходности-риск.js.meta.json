      "use": {
        "title": "Применение",
        "code": {
          "language": "js",
          "content": "const цены = [100, 102, 101, 105, 103, 108];\n\n// шаг 1: массив цен → массив доходностей\nfunction доходности(цены){\n  const out = [];\n  for(let i = 1; i < цены.length; i++) out.push(цены[i] / цены[i - 1] - 1);\n  return out;\n}\n// шаг 2: массив доходностей → одно число (риск)\nfunction волатильность(дох){\n  const среднее = дох.reduce((a, b) => a + b, 0) / дох.length;\n  const дисп = дох.reduce((a, b) => a + (b - среднее) * (b - среднее), 0) / дох.length;\n  return Math.sqrt(дисп);\n}\n\nconst дох = доходности(цены);       // провод: массив доходностей\nconst риск = волатильность(дох);    // дох ВХОДИТ сюда → число\nconsole.log(\"риск:\", риск.toFixed(4));"
        },
