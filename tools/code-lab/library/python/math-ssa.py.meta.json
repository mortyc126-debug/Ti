      "use": {
        "title": "Применение",
        "code": {
          "language": "python",
          "content": "import numpy as np\n\ndef ssa_тренд(ряд, L):\n    N = len(ряд)\n    K = N - L + 1\n    # 1) траекторная матрица: столбцы — окна длины L\n    X = np.column_stack([ряд[i:i+L] for i in range(K)])\n    # 2) разложение SVD: X = U · S · Vt (главные компоненты)\n    U, S, Vt = np.linalg.svd(X, full_matrices=False)\n    # 3) первая компонента (самая мощная) = тренд, собираем матрицу ранга 1\n    X0 = S[0] * np.outer(U[:, 0], Vt[0])\n    # 4) диагональное усреднение матрицы обратно в ряд\n    return _усреднить_диагонали(X0)"
        },
