    {
      "q": "Как записать debounce?",
      "hint": "Идея: каждый новый вызов сбрасывает прежний таймер и ставит новый.",
      "auto": false,
      "options": [
        {
          "label": "Своей функцией",
          "kind": "code",
          "ref": "",
          "id": "",
          "note": "Не нужны библиотеки, работает везде.",
          "code": "function debounce(fn, delay = 300) {\n  let timer;\n  return (...args) => {\n    clearTimeout(timer);\n    timer = setTimeout(() => fn(...args), delay);\n  };\n}",
          "lang": "js",
          "steps": []
        },
        {
          "label": "Подключить из библиотеки lodash",
          "kind": "code",
          "ref": "",
          "id": "",
          "note": "Когда lodash уже есть в проекте.",
          "code": "import debounce from 'lodash/debounce';",
          "lang": "js",
          "steps": []
        }
      ]
    },
    {
