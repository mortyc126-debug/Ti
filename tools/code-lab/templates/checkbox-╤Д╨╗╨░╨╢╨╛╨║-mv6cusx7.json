          "language": "js",
          "content": "const checkbox = document.querySelector(\"#showGrid\");\nconst canvas = document.querySelector(\"#previewCanvas\");\n\ncheckbox.addEventListener(\"change\", () => {\n  canvas.classList.toggle(\"show-grid\", checkbox.checked);\n});"
