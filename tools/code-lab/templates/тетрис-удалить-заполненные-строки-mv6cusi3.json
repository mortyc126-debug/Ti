          "language": "js",
          "content": "const board = [\n  [0, 0, 0, 0],\n  [1, 1, 1, 1],\n  [0, 1, 0, 0],\n  [1, 1, 1, 1]\n];\n\nconst kept = board.filter(row => row.some(cell => cell === 0));\nconst cleared = board.length - kept.length;\n\nwhile (kept.length < board.length) {\n  kept.unshift(Array(4).fill(0));\n}\n\nconsole.log(cleared);\nconsole.log(kept.length);"
