        "title": "Применение",
        "code": {
          "language": "js",
          "content": "const particles = [];\n\nfunction burst(x, y) {\n  for (let i = 0; i < 12; i += 1) {\n    particles.push({\n      x,\n      y,\n      vx: Math.random() * 4 - 2,\n      vy: Math.random() * 4 - 2,\n      life: 1\n    });\n  }\n}\n\nfunction updateParticles() {\n  particles.forEach(particle => {\n    particle.x += particle.vx;\n    particle.y += particle.vy;\n    particle.life -= 0.02;\n  });\n}\n\nparticles.length = 0;\nburst(100, 80);\nupdateParticles();\nconsole.log(particles.length);"
        },
