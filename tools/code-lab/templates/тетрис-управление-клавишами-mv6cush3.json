        "code": {
          "language": "js",
          "content": "const state = { x: 3, y: 0 };\n\nwindow.addEventListener(\"keydown\", event => {\n  if (event.key === \"ArrowLeft\") state.x -= 1;\n  if (event.key === \"ArrowRight\") state.x += 1;\n  if (event.key === \"ArrowDown\") state.y += 1;\n\n  console.log(state.x, state.y);\n});"
