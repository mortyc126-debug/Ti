          "language": "js",
          "content": "const canvas = document.querySelector(\"#scene\");\nconst ctx = canvas.getContext(\"2d\");\n\nctx.fillStyle = \"#FF006E\";\nctx.fillRect(20, 20, 100, 60);\nctx.strokeStyle = \"#3DD9FF\";\nctx.lineWidth = 3;\nctx.strokeRect(140, 20, 100, 60);"
