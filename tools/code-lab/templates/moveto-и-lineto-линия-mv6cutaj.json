        "title": "Применение",
        "code": {
          "language": "js",
          "content": "const canvas = document.querySelector(\"#scene\");\nconst ctx = canvas.getContext(\"2d\");\n\nctx.beginPath();\nctx.moveTo(20, 100);\nctx.lineTo(100, 20);\nctx.lineTo(180, 100);\nctx.strokeStyle = \"#B45CFF\";\nctx.lineWidth = 4;\nctx.stroke();"
        },
