          "content": "const canvas = document.querySelector(\"#scene\");\nconst ctx = canvas.getContext(\"2d\");\nconst image = document.querySelector(\"#sourceImage\");\n\nimage.addEventListener(\"load\", () => {\n  ctx.drawImage(image, 10, 10, 120, 80);\n});"
