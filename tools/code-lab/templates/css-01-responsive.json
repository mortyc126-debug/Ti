        "title": "Применение",
        "code": {
          "language": "css",
          "content": ".cards {\n  display: grid;\n  /* колонки сами переносятся: минимум 220px, иначе поровну */\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n  gap: 16px;\n}\n\n.title {\n  /* размер между 18 и 28px, плавно по ширине окна */\n  font-size: clamp(18px, 4vw, 28px);\n}\n\n@media (max-width: 600px) {\n  .cards { gap: 8px; }   /* на телефоне теснее */\n}"
        },
