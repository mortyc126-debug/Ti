(function(){
  const center = document.querySelector('.center'); if(!center) return;

  // языки панелей: frontend рисуются в превью, остальные запускаются на сервере
  const LANGS = [
    { v:'html', t:'HTML', front:true },
    { v:'css',  t:'CSS',  front:true },
    { v:'js',   t:'JS',   front:true },
    { v:'python', t:'Python' },
    { v:'sql',  t:'SQL' },
    { v:'json', t:'JSON' },
    { v:'txt',  t:'текст' },
    { v:'ruby', t:'Ruby' }, { v:'php', t:'PHP' }, { v:'go', t:'Go' },
    { v:'ts', t:'TypeScript' }, { v:'bash', t:'Bash' }, { v:'lua', t:'Lua' }, { v:'r', t:'R' }
  ];
  const isFront = v => { const l = LANGS.find(x => x.v === v); return l && l.front; };
  const langName = v => { const l = LANGS.find(x => x.v === v); return l ? l.t : v; };

  // ── подсветка по языку ──
  // Палитра (та же, что в общем buildHighlight): где хранится — здесь, в C.
  const C = { com:'#9090BB', str:'#52F2C9', num:'#FF8800', kw:'#B45CFF', fn:'#3DD9FF', name:'#CBC2EA', punct:'#9C90C4' };
  const LEGEND = [
    { c:C.fn,  n:'тег / селектор / вызов', d:'имя HTML-тега, CSS-селектора или вызываемой функции' },
    { c:C.kw,  n:'атрибут / свойство / ключевое слово', d:'атрибут тега, свойство CSS или служебное слово языка' },
    { c:C.str, n:'строка', d:'текст в кавычках' },
    { c:C.num, n:'число / размер / цвет', d:'число, размер (px, %), hex-цвет' },
    { c:C.name,n:'имя / значение / текст', d:'переменная, значение свойства, текст страницы' },
    { c:C.com, n:'комментарий', d:'заметка для человека, не выполняется' },
    { c:C.punct,n:'знаки', d:'скобки, точки, операторы' }
  ];
  const spanEl = (color, kind, text) => { const s = document.createElement('span'); if(color) s.style.color = color; if(kind) s.dataset.k = kind; s.textContent = text; return s; };
  const lineDiv = () => { const d = document.createElement('div'); d.className = 'line'; return d; };

  function hlCss(code){
    const lines = []; let inCom = false, inBlk = false, afterColon = false;
    String(code).split('\n').forEach(line => {
      const div = lineDiv(); let i = 0; const n = line.length;
      while(i < n){
        const c = line[i], rest = line.slice(i);
        if(inCom){ const e = line.indexOf('*/', i); if(e < 0){ div.appendChild(spanEl(C.com,'com',line.slice(i))); i = n; } else { div.appendChild(spanEl(C.com,'com',line.slice(i, e+2))); i = e+2; inCom = false; } continue; }
        if(rest.startsWith('/*')){ const e = line.indexOf('*/', i+2); if(e < 0){ div.appendChild(spanEl(C.com,'com',line.slice(i))); i = n; inCom = true; } else { div.appendChild(spanEl(C.com,'com',line.slice(i, e+2))); i = e+2; } continue; }
        if(c === '"' || c === "'"){ let j = i+1; while(j < n && line[j] !== c) j++; j++; div.appendChild(spanEl(C.str,'str',line.slice(i, j))); i = j; continue; }
        if(c === '{'){ div.appendChild(spanEl(C.punct,'punct','{')); i++; inBlk = true; afterColon = false; continue; }
        if(c === '}'){ div.appendChild(spanEl(C.punct,'punct','}')); i++; inBlk = false; afterColon = false; continue; }
        if(c === ';'){ div.appendChild(spanEl(C.punct,'punct',';')); i++; afterColon = false; continue; }
        if(c === ':' && inBlk){ div.appendChild(spanEl(C.punct,'punct',':')); i++; afterColon = true; continue; }
        if(c === '#'){ const mm = /^#[0-9A-Fa-f]+/.exec(rest); if(mm){ div.appendChild(spanEl(C.num,'css-num',mm[0])); i += mm[0].length; continue; } }
        if(/[0-9]/.test(c) || (c === '.' && /[0-9]/.test(line[i+1] || ''))){ const mm = /^[0-9.]+[a-z%]*/i.exec(rest); div.appendChild(spanEl(C.num,'css-num',mm[0])); i += mm[0].length; continue; }
        const wm = /^[A-Za-z_-][\w-]*/.exec(rest);
        if(wm){ const w = wm[0]; let kind, col; if(!inBlk){ kind = 'sel'; col = C.fn; } else if(afterColon){ kind = 'val'; col = C.name; } else { kind = 'prop'; col = C.kw; } div.appendChild(spanEl(col, kind, w)); i += w.length; continue; }
        const ws = /^\s+/.exec(rest); if(ws){ div.appendChild(spanEl(null, null, ws[0])); i += ws[0].length; continue; }
        div.appendChild(spanEl(C.punct,'punct',c)); i++;
      }
      if(!line) div.appendChild(document.createTextNode('​'));
      lines.push(div);
    });
    return lines;
  }

  function hlHtml(code){
    const lines = []; let inCom = false, inTag = false;
    String(code).split('\n').forEach(line => {
      const div = lineDiv(); let i = 0; const n = line.length;
      while(i < n){
        const c = line[i], rest = line.slice(i);
        if(inCom){ const e = line.indexOf('-->', i); if(e < 0){ div.appendChild(spanEl(C.com,'com',line.slice(i))); i = n; } else { div.appendChild(spanEl(C.com,'com',line.slice(i, e+3))); i = e+3; inCom = false; } continue; }
        if(!inTag){
          if(rest.startsWith('<!--')){ const e = line.indexOf('-->', i+4); if(e < 0){ div.appendChild(spanEl(C.com,'com',line.slice(i))); i = n; inCom = true; } else { div.appendChild(spanEl(C.com,'com',line.slice(i, e+3))); i = e+3; } continue; }
          if(c === '<'){ let j = i+1, slash = ''; if(line[j] === '/'){ slash = '/'; j++; } div.appendChild(spanEl(C.punct,'punct','<'+slash)); const wm = /^[A-Za-z!][\w-]*/.exec(line.slice(j)); if(wm){ div.appendChild(spanEl(C.fn,'tag',wm[0])); j += wm[0].length; } i = j; inTag = true; continue; }
          const lt = line.indexOf('<', i); const seg = lt < 0 ? line.slice(i) : line.slice(i, lt); div.appendChild(spanEl(C.name,'text',seg)); i += seg.length || 1; continue;
        } else {
          if(rest.startsWith('/>')){ div.appendChild(spanEl(C.punct,'punct','/>')); i += 2; inTag = false; continue; }
          if(c === '>'){ div.appendChild(spanEl(C.punct,'punct','>')); i++; inTag = false; continue; }
          if(c === '"' || c === "'"){ let j = i+1; while(j < n && line[j] !== c) j++; j++; div.appendChild(spanEl(C.str,'str',line.slice(i, j))); i = j; continue; }
          if(c === '='){ div.appendChild(spanEl(C.punct,'punct','=')); i++; continue; }
          const wm = /^[A-Za-z_:][\w:-]*/.exec(rest); if(wm){ div.appendChild(spanEl(C.kw,'attr',wm[0])); i += wm[0].length; continue; }
          const ws = /^\s+/.exec(rest); if(ws){ div.appendChild(spanEl(null, null, ws[0])); i += ws[0].length; continue; }
          div.appendChild(spanEl(C.punct,'punct',c)); i++;
        }
      }
      if(!line) div.appendChild(document.createTextNode('​'));
      lines.push(div);
    });
    return lines;
  }

  function sbHighlight(code, lang){
    if(lang === 'css') return hlCss(code);
    if(lang === 'html') return hlHtml(code);
    return window.buildHighlight ? window.buildHighlight(code) : [(() => { const d = lineDiv(); d.textContent = code; return d; })()];
  }
  window.sbHighlight = sbHighlight;

  // ── авто-пары: печатаешь «<body>» → появляется «</body>», «{» → «}», кавычки/скобки парой ──
  const VOID_TAGS = new Set(['area','base','br','col','embed','hr','img','input','link','meta','param','source','track','wbr','!doctype']);
  const PAIR = { '(': ')', '[': ']', '{': '}', '"': '"', "'": "'", '`': '`' };
  // обрабатывает нажатие; возвращает true (вставили пару/удалили), 'skip' (перешагнули) или false (не наше)
  function autoPair(ev, ta, lang){
    const k = ev.key, s = ta.selectionStart, e = ta.selectionEnd, v = ta.value, html = (lang === 'html' || lang === 'htm');
    // перешагнуть уже стоящую закрывающую — чтобы не плодить вторую
    if((k === ')' || k === ']' || k === '}' || k === '"' || k === "'" || k === '`') && s === e && v[s] === k){ ev.preventDefault(); ta.selectionStart = ta.selectionEnd = s + 1; return 'skip'; }
    // backspace между пустой парой → снести обе
    if(k === 'Backspace' && s === e && s > 0 && PAIR[v[s - 1]] === v[s]){ ev.preventDefault(); ta.value = v.slice(0, s - 1) + v.slice(s + 1); ta.selectionStart = ta.selectionEnd = s - 1; return true; }
    // открывающая скобка/кавычка → вставить пару
    if(PAIR[k] && s === e){
      if((k === '"' || k === "'" || k === '`') && /[\w]/.test(v[s] || '')) return false;   // апостроф внутри слова — не парим
      ev.preventDefault(); const c = PAIR[k]; ta.value = v.slice(0, s) + k + c + v.slice(e); ta.selectionStart = ta.selectionEnd = s + 1; return true;
    }
    // «>» завершает открывающий HTML-тег <name …> → дописать </name>
    if(k === '>' && html && s === e){
      const before = v.slice(0, s), m = before.match(/<([a-zA-Z][\w-]*)(?:\s[^<>]*)?$/);
      if(m && !/\/\s*$/.test(before) && !VOID_TAGS.has(m[1].toLowerCase())){ ev.preventDefault(); ta.value = before + '>' + '</' + m[1] + '>' + v.slice(e); ta.selectionStart = ta.selectionEnd = s + 1; return true; }
    }
    return false;
  }

  const DEFAULTS = [
    { id:'f1', name:'index.html', lang:'html', code:'<h1>Привет!</h1>\n<p>Меняй код слева — превью обновится само.</p>\n<button id="b">нажми</button>' },
    { id:'f2', name:'style.css', lang:'css', code:'body{ font-family:system-ui, sans-serif; padding:24px; background:#0E0720; color:#eee }\nh1{ color:#52F2C9 }\nbutton{ padding:8px 14px; border-radius:8px; border:0; background:#FF006E; color:#fff; cursor:pointer }' },
    { id:'f3', name:'script.js', lang:'js', code:'document.getElementById("b").addEventListener("click", () => {\n  console.log("кнопка нажата");\n  document.querySelector("p").textContent = "Готово ✓";\n});' }
  ];

  let files = [];
  try { const s = JSON.parse(localStorage.getItem('codelab_sandbox') || 'null'); if(Array.isArray(s) && s.length) files = s; } catch(_){}
  if(!files.length) files = DEFAULTS.map(f => ({ ...f }));
  let live = true;
  try { live = localStorage.getItem('codelab_sandbox_live') !== '0'; } catch(_){}
  let ros = []; // ResizeObserver'ы панелей (чтобы отключать при перерисовке)

  const save = () => { try { localStorage.setItem('codelab_sandbox', JSON.stringify(files)); } catch(_){} };
  const uid = () => 'f' + Date.now().toString(36) + Math.random().toString(36).slice(2, 5);
  // копирование в буфер + короткая отметка «✓» на кнопке
  function copyText(text, btn){
    const done = () => { if(!btn) return; const o = btn.textContent; btn.textContent = '✓'; setTimeout(() => { btn.textContent = o; }, 900); };
    const fallback = () => { const t = document.createElement('textarea'); t.value = text; t.style.position = 'fixed'; t.style.opacity = '0'; document.body.appendChild(t); t.select(); try { document.execCommand('copy'); } catch(_){} t.remove(); done(); };
    if(navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, fallback); else fallback();
  }

  // ── DOM песочницы ──
  const box = document.createElement('div');
  box.className = 'sandbox'; box.id = 'sandbox'; box.style.display = 'none';
  box.innerHTML =
    '<div class="sb-eds" id="sbEds"></div>' +
    '<div class="sb-gut" id="sbGut" title="потяни — шире редактор или превью"></div>' +
    '<div class="sb-right">' +
      '<div class="sb-bar">' +
        '<button class="btn ok" id="sbRun">▶ запустить</button>' +
        '<button class="btn" id="sbCopyAll" title="скопировать весь собранный документ (HTML+CSS+JS вместе) — вставить в файл">⧉ копировать итог</button>' +
        '<label class="sb-live"><input type="checkbox" id="sbLive"> живой предпросмотр</label>' +
        '<button class="btn" id="sbAdd">+ файл</button>' +
        '<label class="sb-live" title="когда включено — клик по слову в коде показывает пояснение. Редактировать код можно всё равно."><input type="checkbox" id="sbExplain"> 🔍 пояснения по клику</label>' +
        '<button class="btn" id="sbLegend" title="что значат цвета в коде">🎨 цвета</button>' +
        '<span style="flex:1"></span>' +
        '<button class="btn" id="sbClr">× консоль</button>' +
      '</div>' +
      '<iframe class="sb-frame" id="sbFrame" sandbox="allow-scripts allow-modals"></iframe>' +
      '<pre class="sb-con" id="sbCon"></pre>' +
    '</div>';
  center.appendChild(box);

  const edsEl = box.querySelector('#sbEds'), frame = box.querySelector('#sbFrame'), conEl = box.querySelector('#sbCon');
  const liveIn = box.querySelector('#sbLive'); liveIn.checked = live;

  // ── сборка документа для превью из frontend-файлов ──
  function buildDoc(){
    const html = files.filter(f => f.lang === 'html').map(f => f.code).join('\n');
    const css = files.filter(f => f.lang === 'css').map(f => f.code).join('\n');
    const js = files.filter(f => f.lang === 'js' || f.lang === 'ts').map(f => f.code).join('\n;\n');
    const cap = '<scr' + 'ipt>(function(){function s(t,a){try{parent.postMessage({__sb:1,t:t,m:a},"*")}catch(e){}}' +
      '["log","error","warn","info"].forEach(function(k){var o=console[k]?console[k].bind(console):function(){};console[k]=function(){o.apply(null,arguments);s(k,Array.prototype.map.call(arguments,function(x){try{return typeof x==="object"?JSON.stringify(x):String(x)}catch(e){return String(x)}}).join(" "))}});' +
      'window.addEventListener("error",function(e){s("error",e.message+(e.lineno?" (строка "+e.lineno+")":""))});' +
      'window.addEventListener("unhandledrejection",function(e){s("error","Promise: "+(e.reason&&e.reason.message||e.reason))});})();<\/scr' + 'ipt>';
    const style = css ? '<style>\n' + css + '\n</style>' : '';
    const script = js ? '<scr' + 'ipt>\n' + js + '\n<\/scr' + 'ipt>' : '';
    if(/<html[\s>]/i.test(html)){
      // уже целый документ — дописываем стиль в <head>, скрипт и захват консоли перед </body>
      let doc = html.replace(/<\/head>/i, style + '</head>');
      if(!/<\/head>/i.test(html)) doc = style + doc;
      doc = doc.replace(/<\/body>/i, cap + script + '</body>');
      if(!/<\/body>/i.test(html)) doc = doc + cap + script;
      return doc;
    }
    return '<!doctype html><html><head><meta charset="utf-8">' + style + '</head><body>' + cap + html + script + '</body></html>';
  }

  let t = null;
  function renderPreview(){
    frame.srcdoc = buildDoc();
  }
  function schedulePreview(){ if(!live) return; clearTimeout(t); t = setTimeout(renderPreview, 350); }

  window.addEventListener('message', e => {
    const d = e.data; if(!d || !d.__sb) return;
    const mark = d.t === 'error' ? '🔴' : d.t === 'warn' ? '🟡' : '·';
    conEl.textContent += mark + ' ' + d.m + '\n';
    conEl.scrollTop = conEl.scrollHeight;
  });

  // ── запуск одного файла на сервере (python и пр.) ──
  async function runServer(f){
    conEl.textContent += '▶ ' + f.name + ' (' + langName(f.lang) + ')…\n';
    conEl.scrollTop = conEl.scrollHeight;
    let r;
    try { r = await fetch('/api/run', { method:'POST', body: JSON.stringify({ lang: f.lang, code: f.code }) }).then(x => x.json()); }
    catch(_){ r = { ok:false, error:'сервер недоступен — запусти node tools/code-lab-server.mjs' }; }
    if(!r.ok){ conEl.textContent += '🔴 ' + (r.error || 'ошибка') + '\n'; }
    else {
      if(r.stdout) conEl.textContent += r.stdout + (r.stdout.endsWith('\n') ? '' : '\n');
      if(r.stderr) conEl.textContent += '🟡 ' + r.stderr + (r.stderr.endsWith('\n') ? '' : '\n');
      if(r.timedOut) conEl.textContent += '🔴 превышено время (10с)\n';
      if(!r.stdout && !r.stderr) conEl.textContent += '(без вывода, код выхода ' + r.code + ')\n';
    }
    conEl.scrollTop = conEl.scrollHeight;
  }

  // ── разбор: клик по слову → пояснение ──
  // роль слова определяем по цвету, которым его раскрасил buildHighlight
  const COLOR_ROLE = { '#9090bb':'комментарий', '#52f2c9':'строка', '#ff8800':'число', '#b45cff':'ключевое слово', '#3dd9ff':'имя/вызов', '#cbc2ea':'имя', '#9c90c4':'знак' };
  function roleOf(sp){
    let c = sp.style.color || '';
    const m = /rgb\((\d+),\s*(\d+),\s*(\d+)\)/.exec(c);
    if(m) c = '#' + [1,2,3].map(i => (+m[i]).toString(16).padStart(2,'0')).join('');
    return COLOR_ROLE[c.toLowerCase()] || 'имя';
  }
  // короткие пояснения по частым словам (JS + немного CSS/HTML)
  const EXPLAIN = {
    const:'const — объявляет имя, значение которого не будут переназначать. Читается как «постоянная».',
    let:'let — объявляет переменную, значение которой можно менять позже.',
    var:'var — старый способ объявить переменную. Сейчас предпочитают let/const.',
    function:'function — объявляет функцию: кусок кода, который можно вызывать по имени.',
    return:'return — функция отдаёт это значение обратно тому, кто её вызвал, и завершается.',
    if:'if — «если»: выполнить блок, только когда условие в скобках истинно.',
    else:'else — «иначе»: что делать, когда условие if не выполнилось.',
    for:'for — цикл: повторять блок заданное число раз.',
    while:'while — цикл: повторять блок, пока условие истинно.',
    async:'async — помечает функцию как асинхронную; внутри можно использовать await.',
    await:'await — ждёт результат промиса (например ответа из сети), не блокируя страницу.',
    new:'new — создаёт новый объект по «чертежу» (классу или конструктору).',
    class:'class — описывает «чертёж» объектов: их свойства и методы.',
    import:'import — подключает код из другого файла/модуля.',
    export:'export — открывает имя наружу, чтобы его можно было импортировать.',
